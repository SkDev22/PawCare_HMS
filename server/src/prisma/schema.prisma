generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// CLINIC & CONFIGURATION
// ─────────────────────────────────────────

enum ClinicPlan {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

model Clinic {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  address       String?
  phone         String?
  email         String?
  logo_url      String?
  timezone      String     @default("UTC")
  currency      String     @default("LKR")
  // Preset slug (e.g. "green", "blue") selected from the frontend's
  // THEME_PRESETS registry — controls the app's accent color for this
  // clinic. Not a raw hex value, so the palette stays curated.
  theme_color   String     @default("green")
  is_active     Boolean    @default(true)
  plan          ClinicPlan @default(TRIAL)
  trial_ends_at DateTime?
  // Manual-payment plans (BASIC/PRO/ENTERPRISE) have no auto-billing — this
  // is set by ops each time a payment comes in (clinic:upgrade
  // --set-payment-due) and drives the in-app reminder banner + email.
  // Never used for TRIAL clinics (see trial_ends_at/isTrialExpired for that).
  next_payment_due_at DateTime?
  // Individually-granted add-on features beyond the plan's normal bundle —
  // e.g. one clinic buying a module that isn't part of its plan tier, without
  // changing what any other clinic on that same plan sees (see ADR-04).
  extra_features String[] @default([])
  // Ops-set escape hatch beyond the plan's default staff seat count (see
  // PLAN_SEAT_LIMITS) — null means "use the plan default". Set via
  // clinic:upgrade --seat-limit-override, same as extra_features.
  seat_limit_override Int?
  // Percentage (e.g. 8.5 = 8.5%). Auto-applied to new invoices' tax_amount
  // as line items are added/removed, until a staff member manually edits an
  // invoice's tax amount — see Invoice.tax_auto.
  tax_rate            Decimal @default(0) @db.Decimal(5, 2)
  invoice_prefix       String  @default("INV-")
  // The number to assign to the *next* invoice created; incremented
  // atomically at invoice-creation time (see billing.service.createInvoice).
  invoice_next_number  Int     @default(1)
  invoice_due_days     Int     @default(14)
  invoice_footer_text  String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  staff               StaffUser[]
  services            Service[]
  rooms               Room[]
  goods_received_notes GoodsReceivedNote[]
  suppliers            Supplier[]
  hours                ClinicHours[]

  @@map("clinics")
}

// One row per day of the week (0=Sun … 6=Sat). open_time/close_time use the
// same "HH:MM" string convention as StaffSchedule. A day not present in the
// table (or with is_closed = true) is treated as closed.
model ClinicHours {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id   String   @db.Uuid
  day_of_week Int
  open_time   String?
  close_time  String?
  is_closed   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  clinic Clinic @relation(fields: [clinic_id], references: [id])

  @@unique([clinic_id, day_of_week])
  @@map("clinic_hours")
}

// ─────────────────────────────────────────
// STAFF & AUTHENTICATION
// ─────────────────────────────────────────

enum StaffRole {
  ADMIN
  VETERINARIAN
  NURSE
  RECEPTIONIST
  LAB_TECHNICIAN
}

model StaffUser {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id      String    @db.Uuid
  email          String    @unique
  password_hash  String
  first_name     String
  last_name      String
  role           StaffRole
  specialization String?
  license_number String?
  phone          String?
  avatar_url     String?
  is_active      Boolean   @default(true)
  last_login_at  DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  clinic          Clinic          @relation(fields: [clinic_id], references: [id])
  refresh_tokens  RefreshToken[]
  appointments    Appointment[]
  soap_notes      SoapNote[]
  schedules       StaffSchedule[]
  medical_records MedicalRecord[]
  lab_orders      LabOrder[]      @relation("LabOrderVet")
  medical_record_charges MedicalRecordCharge[]
  goods_received_notes   GoodsReceivedNote[]

  @@map("staff_users")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id   String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  staff StaffUser @relation(fields: [staff_id], references: [id])

  @@index([staff_id])
  @@map("refresh_tokens")
}

model StaffSchedule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id    String   @db.Uuid
  day_of_week Int
  start_time  String
  end_time    String
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  staff StaffUser @relation(fields: [staff_id], references: [id])

  @@map("staff_schedules")
}

// ─────────────────────────────────────────
// OWNERS (CLIENTS) & PETS (PATIENTS)
// ─────────────────────────────────────────

model Owner {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id         String    @db.Uuid
  email             String?   @unique
  password_hash     String?
  first_name        String
  last_name         String
  phone             String
  address           String?
  emergency_contact String?
  preferred_contact String    @default("email")
  portal_enabled    Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  pets     Pet[]
  invoices Invoice[]

  @@map("owners")
}

enum Species {
  DOG
  CAT
  BIRD
  RABBIT
  REPTILE
  SMALL_MAMMAL
  OTHER
}

enum PetStatus {
  ACTIVE
  DECEASED
  TRANSFERRED
  INACTIVE
}

model Pet {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id     String    @db.Uuid
  name         String
  species      Species
  breed        String?
  date_of_birth DateTime?
  weight_kg    Decimal?  @db.Decimal(6, 2)
  sex          String?
  color        String?
  photo_url    String?
  insurance_id String?
  status       PetStatus @default(ACTIVE)
  notes        String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  owner            Owner             @relation(fields: [owner_id], references: [id])
  appointments     Appointment[]
  medical_records  MedicalRecord[]
  vaccinations     Vaccination[]
  allergies        Allergy[]
  prescriptions    Prescription[]
  hospitalizations Hospitalization[]
  lab_orders       LabOrder[]

  @@map("pets")
}

model Allergy {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pet_id   String   @db.Uuid
  allergen String
  reaction String?
  severity String?
  noted_at DateTime @default(now())

  pet Pet @relation(fields: [pet_id], references: [id])

  @@map("allergies")
}

// ─────────────────────────────────────────
// APPOINTMENTS
// ─────────────────────────────────────────

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  WELLNESS_EXAM
  VACCINATION
  SICK_VISIT
  SURGERY
  DENTAL
  FOLLOW_UP
  EMERGENCY
  GROOMING
  LAB_ONLY
}

model Appointment {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id     String            @db.Uuid
  pet_id        String            @db.Uuid
  vet_id        String            @db.Uuid
  room_id       String?           @db.Uuid
  type          AppointmentType
  status        AppointmentStatus @default(SCHEDULED)
  start_at      DateTime
  end_at        DateTime
  reason        String?
  notes         String?
  is_walk_in    Boolean           @default(false)
  daily_number  Int?
  checked_in_at DateTime?
  cancelled_at  DateTime?
  cancel_reason String?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  pet            Pet            @relation(fields: [pet_id], references: [id])
  vet            StaffUser      @relation(fields: [vet_id], references: [id])
  room           Room?          @relation(fields: [room_id], references: [id])
  medical_record MedicalRecord?
  invoice        Invoice?

  @@index([clinic_id, start_at])
  @@index([vet_id, start_at])
  @@map("appointments")
}

// Per-clinic, per-day sequence used to assign a short human-readable
// "appointment #" (resets to 1 each day, keyed by the appointment's
// scheduled date — not the date it was booked). Assigned atomically via
// upsert-with-increment so concurrent bookings never collide.
model DailyCounter {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id  String   @db.Uuid
  date       DateTime @db.Date
  counter    Int      @default(0)
  updated_at DateTime @updatedAt

  @@unique([clinic_id, date])
  @@map("daily_counters")
}

model Room {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id  String   @db.Uuid
  name       String
  type       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  clinic        Clinic        @relation(fields: [clinic_id], references: [id])
  appointments  Appointment[]
  kennel_units  KennelUnit[]

  @@map("rooms")
}

// ─────────────────────────────────────────
// ELECTRONIC MEDICAL RECORDS (EMR)
// ─────────────────────────────────────────

model MedicalRecord {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pet_id          String    @db.Uuid
  appointment_id  String?   @unique @db.Uuid
  vet_id          String    @db.Uuid
  visit_date      DateTime  @default(now())
  chief_complaint String?
  next_visit_date DateTime? @db.Date
  next_visit_note String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  pet         Pet           @relation(fields: [pet_id], references: [id])
  vet         StaffUser     @relation(fields: [vet_id], references: [id])
  appointment Appointment?  @relation(fields: [appointment_id], references: [id])
  soap_note   SoapNote?
  vitals      Vitals?
  lab_results LabResult[]
  prescriptions Prescription[]
  attachments Attachment[]
  diagnoses   Diagnosis[]
  charges     MedicalRecordCharge[]

  @@index([pet_id, visit_date])
  @@map("medical_records")
}

// Before/after trail for every mutation reachable from a medical record
// (the record itself, its SOAP note, vitals, diagnoses, prescriptions, and
// charges) — see emr.service.ts and lib/audit-log.ts. medical_record_id is
// denormalized onto every row, even for a Diagnosis/Charge whose own id is
// in entity_id, so a record's whole trail is one indexed query. Never
// purged — an audit trail that deletes itself defeats the point.
model AuditLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id         String   @db.Uuid
  medical_record_id String   @db.Uuid
  entity_type       String
  entity_id         String   @db.Uuid
  action            String
  before            Json?
  after             Json?
  performed_by      String   @db.Uuid
  created_at        DateTime @default(now())

  @@index([clinic_id, medical_record_id, created_at])
  @@map("audit_logs")
}

model SoapNote {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medical_record_id String   @unique @db.Uuid
  vet_id            String   @db.Uuid
  note              String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  medical_record MedicalRecord @relation(fields: [medical_record_id], references: [id])
  vet            StaffUser     @relation(fields: [vet_id], references: [id])

  @@map("soap_notes")
}

model Vitals {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medical_record_id    String   @unique @db.Uuid
  weight_kg            Decimal? @db.Decimal(6, 2)
  temperature_c        Decimal? @db.Decimal(4, 1)
  heart_rate_bpm       Int?
  respiratory_rate     Int?
  blood_pressure       String?
  body_condition_score Int?
  recorded_at          DateTime @default(now())

  medical_record MedicalRecord @relation(fields: [medical_record_id], references: [id])

  @@map("vitals")
}

model Diagnosis {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medical_record_id String   @db.Uuid
  code              String?
  name              String
  is_primary        Boolean  @default(false)
  notes             String?
  created_at        DateTime @default(now())

  medical_record MedicalRecord @relation(fields: [medical_record_id], references: [id])

  @@map("diagnoses")
}

model Attachment {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medical_record_id String   @db.Uuid
  file_name         String
  file_type         String
  mime_type         String
  s3_key            String
  size_bytes        Int
  deleted_at        DateTime?
  uploaded_at       DateTime @default(now())

  medical_record MedicalRecord @relation(fields: [medical_record_id], references: [id])

  @@map("attachments")
}

// ─────────────────────────────────────────
// VACCINATIONS
// ─────────────────────────────────────────

model Vaccination {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pet_id          String    @db.Uuid
  vaccine_name    String
  manufacturer    String?
  lot_number      String?
  administered_at DateTime
  next_due_at     DateTime?
  administered_by String    @db.Uuid
  notes           String?
  created_at      DateTime  @default(now())

  pet Pet @relation(fields: [pet_id], references: [id])

  @@map("vaccinations")
}

// ─────────────────────────────────────────
// PRESCRIPTIONS & MEDICATIONS
// ─────────────────────────────────────────

model Prescription {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pet_id            String    @db.Uuid
  medical_record_id String?   @db.Uuid
  prescribed_by     String    @db.Uuid
  drug_name         String
  dosage            String
  frequency         String
  duration_days     Int?
  quantity          Int?
  refills_remaining Int       @default(0)
  instructions      String?
  dispensed_at      DateTime?
  expires_at        DateTime?
  is_active         Boolean   @default(true)
  item_id           String?   @db.Uuid
  charge_id         String?   @unique @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  pet            Pet                  @relation(fields: [pet_id], references: [id])
  medical_record MedicalRecord?       @relation(fields: [medical_record_id], references: [id])
  item           InventoryItem?       @relation(fields: [item_id], references: [id])
  charge         MedicalRecordCharge? @relation(fields: [charge_id], references: [id])
  controlled_substance_approval ControlledSubstanceApproval?

  @@map("prescriptions")
}

// ─────────────────────────────────────────
// CONTROLLED SUBSTANCE DUAL APPROVAL
// ─────────────────────────────────────────
// A controlled item's prescription defers its charge/stock deduction until a
// *different* staff member signs off — see emr.service.ts:addPrescription.
// Nothing else is created for a rejected request, so there's nothing to
// reverse: unlike a normal prescription, charge_id stays null until approved.

enum ControlledDispenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model ControlledSubstanceApproval {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id        String                   @db.Uuid
  prescription_id  String                   @unique @db.Uuid
  item_id          String                   @db.Uuid
  // Carries forward the prescriber's batch choice (if any) to whenever this
  // gets approved — otherwise a deliberate batch pick would be silently
  // lost and fall back to FIFO at approval time. Null means "use FIFO",
  // same as everywhere else this pattern appears.
  batch_id         String?                  @db.Uuid
  quantity         Int
  requested_by     String                   @db.Uuid
  status           ControlledDispenseStatus @default(PENDING)
  approved_by      String?                  @db.Uuid
  decided_at       DateTime?
  rejection_reason String?
  created_at       DateTime                 @default(now())

  prescription Prescription  @relation(fields: [prescription_id], references: [id])
  item         InventoryItem @relation(fields: [item_id], references: [id])

  @@index([clinic_id, status])
  @@map("controlled_substance_approvals")
}

// ─────────────────────────────────────────
// LABORATORY
// ─────────────────────────────────────────

enum LabStatus {
  PENDING
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model LabOrder {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pet_id            String    @db.Uuid
  ordered_by        String    @db.Uuid
  panel_name        String
  status            LabStatus @default(PENDING)
  is_external       Boolean   @default(false)
  external_lab_name String?
  ordered_at        DateTime  @default(now())
  completed_at      DateTime?
  notes             String?

  pet     Pet       @relation(fields: [pet_id], references: [id])
  vet     StaffUser @relation("LabOrderVet", fields: [ordered_by], references: [id])
  results LabResult[]

  @@map("lab_orders")
}

model LabResult {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lab_order_id      String    @db.Uuid
  medical_record_id String?   @db.Uuid
  test_name         String
  value             String
  unit              String?
  reference_min     String?
  reference_max     String?
  is_abnormal       Boolean   @default(false)
  recorded_at       DateTime  @default(now())

  lab_order      LabOrder       @relation(fields: [lab_order_id], references: [id])
  medical_record MedicalRecord? @relation(fields: [medical_record_id], references: [id])

  @@map("lab_results")
}

// ─────────────────────────────────────────
// WARD & HOSPITALIZATION
// ─────────────────────────────────────────

enum KennelStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  OUT_OF_SERVICE
}

model KennelUnit {
  id      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id String       @db.Uuid
  label   String
  size    String
  status  KennelStatus @default(AVAILABLE)
  notes   String?

  room             Room              @relation(fields: [room_id], references: [id])
  hospitalizations Hospitalization[]

  @@map("kennel_units")
}

model Hospitalization {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pet_id              String    @db.Uuid
  kennel_id           String    @db.Uuid
  admitted_by         String    @db.Uuid
  reason              String
  admitted_at         DateTime  @default(now())
  discharged_at       DateTime?
  discharge_notes     String?
  estimated_stay_days Int?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  pet      Pet        @relation(fields: [pet_id], references: [id])
  kennel   KennelUnit @relation(fields: [kennel_id], references: [id])
  care_logs CareLog[]

  @@map("hospitalizations")
}

model CareLog {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalization_id String   @db.Uuid
  performed_by       String   @db.Uuid
  type               String
  notes              String
  logged_at          DateTime @default(now())

  hospitalization Hospitalization @relation(fields: [hospitalization_id], references: [id])

  @@map("care_logs")
}

// ─────────────────────────────────────────
// INVENTORY & PHARMACY
// ─────────────────────────────────────────

enum ItemCategory {
  MEDICATION
  VACCINE
  SURGICAL_SUPPLY
  DIAGNOSTIC_SUPPLY
  FOOD
  EQUIPMENT
  OTHER
}

model InventoryItem {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id          String       @db.Uuid
  name               String
  sku                String?      @unique
  category           ItemCategory
  unit               String
  quantity_on_hand   Int          @default(0)
  reorder_threshold  Int          @default(10)
  supplier_name      String?
  supplier_sku       String?
  location           String?
  is_controlled      Boolean      @default(false)
  is_active          Boolean      @default(true)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  transactions       InventoryTransaction[]
  invoice_line_items InvoiceLineItem[]
  charges            MedicalRecordCharge[]
  prescriptions      Prescription[]
  batches            StockBatch[]
  grn_items          GoodsReceivedNoteItem[]
  controlled_approvals ControlledSubstanceApproval[]

  @@map("inventory_items")
}

// A single physical lot of stock for an item — created exclusively by receiving
// a GoodsReceivedNote line (or, for pre-existing data, by the one-time backfill
// migration). Cost, selling price, discount, and expiry are per-batch so that
// older discounted stock keeps selling at its own terms after a restock at a
// different price.
model StockBatch {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id            String    @db.Uuid
  grn_item_id        String?   @unique @db.Uuid
  batch_no           String?
  quantity_received  Int
  quantity_remaining Int
  unit_cost          Decimal   @db.Decimal(10, 2)
  selling_price      Decimal   @db.Decimal(10, 2)
  discount_percent   Decimal   @default(0) @db.Decimal(5, 2)
  expiry_date        DateTime?
  received_at        DateTime  @default(now())
  is_closed          Boolean   @default(false)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  item         InventoryItem          @relation(fields: [item_id], references: [id])
  grn_item     GoodsReceivedNoteItem? @relation(fields: [grn_item_id], references: [id])
  transactions InventoryTransaction[]
  charges      MedicalRecordCharge[]
  line_items   InvoiceLineItem[]

  @@map("stock_batches")
}

// A reusable supplier record, scoped per clinic. GRNs snapshot the supplier's
// name at the time of receiving (see GoodsReceivedNote.supplier_name) so a
// later rename doesn't rewrite history, but also link supplier_id so the same
// supplier can be searched/reused across GRNs instead of retyped every time.
model Supplier {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id  String   @db.Uuid
  name       String
  phone      String?
  email      String?
  address    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  clinic                Clinic              @relation(fields: [clinic_id], references: [id])
  goods_received_notes  GoodsReceivedNote[]

  @@unique([clinic_id, name])
  @@map("suppliers")
}

model GoodsReceivedNote {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id           String   @db.Uuid
  grn_number          String
  supplier_id         String?  @db.Uuid
  supplier_name       String
  supplier_invoice_no String?
  notes               String?
  received_by         String   @db.Uuid
  received_at         DateTime @default(now())
  created_at          DateTime @default(now())

  clinic            Clinic                  @relation(fields: [clinic_id], references: [id])
  supplier          Supplier?               @relation(fields: [supplier_id], references: [id])
  received_by_staff StaffUser               @relation(fields: [received_by], references: [id])
  items             GoodsReceivedNoteItem[]

  @@unique([clinic_id, grn_number])
  @@map("goods_received_notes")
}

model GoodsReceivedNoteItem {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grn_id           String    @db.Uuid
  item_id          String    @db.Uuid
  batch_no         String?
  quantity         Int
  unit_cost        Decimal   @db.Decimal(10, 2)
  selling_price    Decimal   @db.Decimal(10, 2)
  discount_percent Decimal   @default(0) @db.Decimal(5, 2)
  expiry_date      DateTime?
  created_at       DateTime  @default(now())

  grn   GoodsReceivedNote @relation(fields: [grn_id], references: [id])
  item  InventoryItem     @relation(fields: [item_id], references: [id])
  batch StockBatch?

  @@map("goods_received_note_items")
}

model InventoryTransaction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id      String   @db.Uuid
  batch_id     String?  @db.Uuid
  performed_by String   @db.Uuid
  type         String
  quantity     Int
  reference_id String?
  notes        String?
  created_at   DateTime @default(now())

  item  InventoryItem @relation(fields: [item_id], references: [id])
  batch StockBatch?   @relation(fields: [batch_id], references: [id])

  @@map("inventory_transactions")
}

// ─────────────────────────────────────────
// SERVICES & BILLING
// ─────────────────────────────────────────

model Service {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id        String   @db.Uuid
  name             String
  category         String
  price            Decimal  @db.Decimal(10, 2)
  duration_minutes Int?
  is_taxable       Boolean  @default(true)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  clinic             Clinic            @relation(fields: [clinic_id], references: [id])
  invoice_line_items InvoiceLineItem[]
  charges            MedicalRecordCharge[]

  @@map("services")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

model Invoice {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinic_id                String        @db.Uuid
  owner_id                 String        @db.Uuid
  appointment_id           String?       @unique @db.Uuid
  // Human-readable number assigned once at creation from the clinic's
  // invoice_prefix/invoice_next_number counter — never reassigned, even if
  // the clinic later changes its prefix. Null on invoices created before
  // this field existed (see db:backfill-invoice-numbers).
  invoice_number           String?
  status                   InvoiceStatus @default(DRAFT)
  subtotal                 Decimal       @db.Decimal(10, 2)
  tax_amount               Decimal       @default(0) @db.Decimal(10, 2)
  // True until a staff member explicitly sets tax_amount via an invoice
  // update, at which point it locks and stops being recalculated as line
  // items change (see billing.service.ts).
  tax_auto                 Boolean       @default(true)
  discount_amount          Decimal       @default(0) @db.Decimal(10, 2)
  total                    Decimal       @db.Decimal(10, 2)
  paid_amount              Decimal       @default(0) @db.Decimal(10, 2)
  due_date                 DateTime?
  notes                    String?
  stripe_payment_intent_id String?
  created_at               DateTime      @default(now())
  updated_at               DateTime      @updatedAt

  owner       Owner           @relation(fields: [owner_id], references: [id])
  appointment Appointment?    @relation(fields: [appointment_id], references: [id])
  line_items  InvoiceLineItem[]
  payments    Payment[]

  @@unique([clinic_id, invoice_number])
  @@index([owner_id, status])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id  String   @db.Uuid
  service_id  String?  @db.Uuid
  item_id     String?  @db.Uuid
  batch_id    String?  @db.Uuid
  description String
  quantity    Int      @default(1)
  unit_price  Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  created_at  DateTime @default(now())

  invoice Invoice        @relation(fields: [invoice_id], references: [id])
  service Service?       @relation(fields: [service_id], references: [id])
  item    InventoryItem? @relation(fields: [item_id], references: [id])
  batch   StockBatch?    @relation(fields: [batch_id], references: [id])
  charge  MedicalRecordCharge?

  @@map("invoice_line_items")
}

model Payment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id       String   @db.Uuid
  amount           Decimal  @db.Decimal(10, 2)
  method           String
  stripe_charge_id String?
  received_at      DateTime @default(now())
  notes            String?
  // A voided payment is never deleted — it stays visible on the invoice for
  // audit purposes, with its effect reversed out of the invoice's
  // paid_amount/status (see billing.service.ts voidPayment).
  voided_at        DateTime?
  voided_reason    String?
  voided_by        String?    @db.Uuid

  invoice Invoice @relation(fields: [invoice_id], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────
// MEDICAL RECORD CHARGES (visit → invoice bridge)
// ─────────────────────────────────────────

model MedicalRecordCharge {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medical_record_id     String   @db.Uuid
  item_id               String?  @db.Uuid
  batch_id              String?  @db.Uuid
  service_id            String?  @db.Uuid
  description           String
  quantity              Int      @default(1)
  unit_price            Decimal  @db.Decimal(10, 2)
  total                 Decimal  @db.Decimal(10, 2)
  invoice_line_item_id  String?  @unique @db.Uuid
  created_by            String   @db.Uuid
  created_at            DateTime @default(now())

  medical_record    MedicalRecord    @relation(fields: [medical_record_id], references: [id])
  item              InventoryItem?   @relation(fields: [item_id], references: [id])
  batch             StockBatch?      @relation(fields: [batch_id], references: [id])
  service           Service?         @relation(fields: [service_id], references: [id])
  invoice_line_item InvoiceLineItem? @relation(fields: [invoice_line_item_id], references: [id])
  created_by_staff  StaffUser        @relation(fields: [created_by], references: [id])
  prescription      Prescription?

  @@index([medical_record_id])
  @@map("medical_record_charges")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id     String?            @db.Uuid
  staff_id     String?            @db.Uuid
  type         String
  channel      String
  subject      String?
  body         String
  status       NotificationStatus @default(PENDING)
  scheduled_at DateTime?
  sent_at      DateTime?
  read_at      DateTime?
  error_msg    String?
  // Dedup key for repeatable/scheduled jobs (e.g. "<clinicId>:<date>") — lets a
  // job re-run safely without creating duplicate notifications for the same
  // recipient. Nullable and unused by event-driven producers.
  reference_id String?            @db.VarChar(150)
  created_at   DateTime           @default(now())

  @@unique([staff_id, type, reference_id])
  @@unique([owner_id, type, reference_id])
  @@index([status, scheduled_at])
  @@index([staff_id, read_at])
  @@map("notifications")
}

// Opt-out preferences: the absence of a row means enabled (the default).
// A row with enabled=false means this staff member turned that notification
// type off. Producers (notifyStaff/notifyRole) check this before creating.
model NotificationPreference {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id String  @db.Uuid
  type     String
  enabled  Boolean @default(true)

  @@unique([staff_id, type])
  @@map("notification_preferences")
}
